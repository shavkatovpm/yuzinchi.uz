---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';
import Schema from '../../../components/Schema.astro';

const features = [
  {
    title: "Точный таргетинг",
    description: "Подбор аудитории по возрасту, полу, гео, интересам и поведению"
  },
  {
    title: "Подготовка креативов",
    description: "Рекламные материалы, которые привлекают внимание и повышают конверсию"
  },
  {
    title: "A/B тестирование",
    description: "Параллельно проверяем несколько связок и оставляем ту, что даёт результат дешевле"
  },
  {
    title: "Ретаргетинг",
    description: "Повторный показ тем, кто заходил на сайт или взаимодействовал с профилем"
  },
  {
    title: "Reels и Stories",
    description: "Размещение в форматах, которые сейчас дают наибольший охват"
  },
  {
    title: "Прозрачный отчёт",
    description: "Еженедельно: потраченный бюджет, количество заявок и цена одной заявки"
  }
];

const steps = [
  { n: 1, title: "Стратегия", text: "Изучаем бизнес и профиль клиента, определяем целевую аудиторию" },
  { n: 2, title: "Креативы", text: "Готовим видео и баннеры, формулируем текст и оффер" },
  { n: 3, title: "Тест", text: "Проверяем несколько вариантов на небольшом бюджете" },
  { n: 4, title: "Масштабирование", text: "Увеличиваем бюджет на связку, которая сработала, и стабилизируем результат" }
];

const faq = [
  {
    question: "Сколько стоит услуга таргета в Instagram?",
    answer: "Услуга начинается от $200 в месяц. Сюда входит настройка аудиторий, подготовка креативов, ведение кампании и еженедельный отчёт. Рекламный бюджет считается отдельно и оплачивается напрямую в Instagram."
  },
  {
    question: "Как заказать услугу таргетированной рекламы?",
    answer: "Оставьте заявку на сайте или напишите в Telegram. Мы разберём ваш бизнес и профиль клиента, после чего скажем, какая аудитория и какой бюджет подойдут. Первая консультация бесплатная."
  },
  {
    question: "Через сколько будет результат?",
    answer: "Первые заявки обычно приходят за 3-7 дней. На стабильный результат нужно 1-2 месяца: за это время тестируются несколько аудиторий и креативов и находится связка с самой низкой ценой заявки."
  },
  {
    question: "Таргет в Instagram подходит любому бизнесу?",
    answer: "Лучше всего работает там, где продукт можно показать визуально: одежда, косметика, рестораны, клиники, образовательные курсы. Если клиент ищет вас через поиск, эффективнее может оказаться Google Ads — мы скажем об этом на этапе анализа."
  },
  {
    question: "На кого оформляется рекламный кабинет?",
    answer: "Кабинет оформляется на вас, все данные остаются у вас. Мы работаем с доступом, и после окончания сотрудничества кабинет остаётся вашим."
  }
];

const title = "Услуга таргета в Instagram в Узбекистане | Yuzinchi";
const description = "Услуга таргетированной рекламы в Instagram: подбор аудитории, креативы, A/B тесты и ретаргетинг. Работаем по Узбекистану, от $200 в месяц. Бесплатная консультация.";
---

<BaseLayout title={title} description={description}>
  <Schema
    breadcrumbs={[
      { name: 'Главная', url: '/ru' },
      { name: 'Услуги', url: '/ru/uslugi' },
      { name: 'Instagram таргет', url: '/ru/uslugi/instagram-target' }
    ]}
    service={{
      name: 'Таргетированная реклама в Instagram',
      description: "Настройка и ведение таргетированных рекламных кампаний в рекламном кабинете Instagram и Facebook",
      serviceType: 'Instagram Targeted Advertising'
    }}
    faq={faq}
  />

  <section class="section-padding">
    <div class="container-custom">
      <div class="mx-auto max-w-4xl">
        <!-- Header -->
        <div class="text-center">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-light/10 bg-light/5">
            <svg class="h-8 w-8 text-light/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
            </svg>
          </div>
          <h1 class="text-4xl font-bold text-light md:text-5xl">
            Таргетированная реклама в Instagram
          </h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-light/60 leading-relaxed">
            Услуга таргета в Instagram выводит вас напрямую на людей, которым может быть интересен ваш продукт.
            Аудиторию подбираем не наугад, а на основе данных.
          </p>
        </div>

        <!-- Stats -->
        <div class="mt-12 grid grid-cols-3 gap-4">
          <div class="rounded-xl border border-light/5 bg-light/[0.02] p-4 text-center">
            <div class="text-2xl font-bold text-accent md:text-3xl">10M+</div>
            <div class="mt-1 text-xs text-light/60">Пользователей в Узбекистане</div>
          </div>
          <div class="rounded-xl border border-light/5 bg-light/[0.02] p-4 text-center">
            <div class="text-2xl font-bold text-accent md:text-3xl">18-45</div>
            <div class="mt-1 text-xs text-light/60">Основной возраст</div>
          </div>
          <div class="rounded-xl border border-light/5 bg-light/[0.02] p-4 text-center">
            <div class="text-2xl font-bold text-accent md:text-3xl">$200+</div>
            <div class="mt-1 text-xs text-light/60">Стоимость в месяц</div>
          </div>
        </div>

        <!-- Features -->
        <div class="mt-16">
          <h2 class="text-center text-2xl font-bold text-light md:text-3xl">
            Что входит в услугу таргета в Instagram?
          </h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {features.map((feature) => (
              <div class="rounded-xl border border-light/5 bg-dark p-6">
                <h3 class="font-semibold text-light">{feature.title}</h3>
                <p class="mt-2 text-sm text-light/60">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Process -->
        <div class="mt-16">
          <h2 class="text-center text-2xl font-bold text-light md:text-3xl">
            Как мы работаем
          </h2>
          <div class="mt-8 space-y-4">
            {steps.map((s) => (
              <div class="flex gap-4 rounded-xl border border-light/5 bg-dark p-6">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-bold text-light">{s.n}</div>
                <div>
                  <h3 class="font-semibold text-light">{s.title}</h3>
                  <p class="mt-1 text-sm text-light/60">{s.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <!-- FAQ -->
        <div class="mt-16">
          <h2 class="text-center text-2xl font-bold text-light md:text-3xl">
            Вопросы об услуге таргета в Instagram
          </h2>
          <div class="mt-8 space-y-3">
            {faq.map((item) => (
              <details class="group rounded-xl border border-light/5 bg-dark p-6">
                <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-light marker:content-none">
                  {item.question}
                  <svg class="h-5 w-5 shrink-0 text-accent transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-light/60">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
