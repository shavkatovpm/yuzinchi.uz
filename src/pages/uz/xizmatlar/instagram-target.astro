---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';
import Schema from '../../../components/Schema.astro';

const features = [
  {
    title: "Aniq maqsadlash (targeting)",
    description: "Yosh, jins, joylashuv, qiziqish va xatti-harakat bo'yicha auditoriyani nuqtali tanlash"
  },
  {
    title: "Kreativ tayyorlash",
    description: "E'tiborni tortadigan va konversiyani oshiradigan reklama materiallari"
  },
  {
    title: "A/B testlash",
    description: "Bir nechta kreativ va auditoriyani parallel sinab, eng arzon natija beradiganini tanlash"
  },
  {
    title: "Retargeting",
    description: "Saytga kirgan yoki profil bilan aloqada bo'lgan foydalanuvchilarga qayta murojaat"
  },
  {
    title: "Reels va Stories reklamasi",
    description: "Hozirda eng ko'p qamrov beradigan formatlarda joylashtirish"
  },
  {
    title: "Shaffof hisobot",
    description: "Har hafta sarflangan budjet, murojaat soni va bitta murojaat narxi bo'yicha hisobot"
  }
];

const steps = [
  { n: 1, title: "Strategiya", text: "Biznesingiz va mijoz profilini o'rganib, maqsadli auditoriyani aniqlaymiz" },
  { n: 2, title: "Kreativ", text: "Video va bannerlar tayyorlaymiz, matn va taklifni shakllantiramiz" },
  { n: 3, title: "Test", text: "Kichik budjet bilan bir nechta variantni sinab ko'ramiz" },
  { n: 4, title: "Kengaytirish", text: "Ishlagan kampaniyaga budjetni oshirib, natijani barqarorlashtiramiz" }
];

const faq = [
  {
    question: "Instagram target xizmati qancha turadi?",
    answer: "Xizmat narxi oyiga $200 dan boshlanadi. Bunga auditoriya sozlash, kreativ tayyorlash, kampaniyani boshqarish va haftalik hisobot kiradi. Reklama budjeti alohida hisoblanadi va to'g'ridan-to'g'ri Instagram'ga to'lanadi."
  },
  {
    question: "Instagram target xizmatini qanday buyurtma qilaman?",
    answer: "Saytdagi ariza shaklini to'ldirasiz yoki Telegram orqali yozasiz. Biznesingizni va mijoz profilini o'rganib chiqamiz, keyin qaysi auditoriya va qanday budjet mos kelishini aytamiz. Birinchi suhbat bepul."
  },
  {
    question: "Natija qancha vaqtda ko'rinadi?",
    answer: "Birinchi murojaatlar odatda 3-7 kun ichida keladi. Barqaror natija uchun 1-2 oy kerak: shu vaqt ichida bir nechta auditoriya va kreativ sinaladi, eng arzon murojaat beradigani topiladi."
  },
  {
    question: "Instagram target reklama har qanday biznesga mos keladimi?",
    answer: "Mahsulot yoki xizmatni vizual ko'rsatish mumkin bo'lgan bizneslarga eng yaxshi ishlaydi: kiyim, kosmetika, restoran, klinika, ta'lim kurslari. Agar mijoz sizni Google'da qidirib topadigan bo'lsa, Google Ads samaraliroq bo'lishi mumkin — buni tahlil bosqichida aytamiz."
  },
  {
    question: "Reklama kabineti kimning nomida bo'ladi?",
    answer: "Kabinet sizning nomingizda bo'ladi va barcha ma'lumotlar sizda qoladi. Biz unga kirish huquqi bilan ishlaymiz, hamkorlik tugasa kabinet sizda saqlanib qoladi."
  }
];

const title = "Instagram target xizmati O'zbekistonda | Yuzinchi";
const description = "Instagram target xizmati: auditoriyani aniq tanlash, kreativ tayyorlash, A/B test va retargeting. O'zbekiston bo'ylab targeting xizmati, oyiga $200 dan. Bepul maslahat oling.";
---

<BaseLayout title={title} description={description}>
  <Schema
    breadcrumbs={[
      { name: 'Asosiy', url: '/uz' },
      { name: 'Xizmatlar', url: '/uz/xizmatlar' },
      { name: 'Instagram target', url: '/uz/xizmatlar/instagram-target' }
    ]}
    service={{
      name: 'Instagram target xizmati',
      description: "Instagram va Facebook reklama kabinetida targetlangan reklama kampaniyalarini sozlash va boshqarish",
      serviceType: 'Instagram Targeted Advertising'
    }}
    faq={faq}
  />

  <section class="section-padding">
    <div class="container-custom">
      <div class="mx-auto max-w-4xl">
        <!-- Header -->
        <div class="text-center">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-light/10 bg-light/5">
            <svg class="h-8 w-8 text-light/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
            </svg>
          </div>
          <h1 class="text-4xl font-bold text-light md:text-5xl">
            Instagram target xizmati
          </h1>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-light/60 leading-relaxed">
            Instagram target xizmati orqali mahsulotingizga qiziqishi mumkin bo'lgan odamlarga to'g'ridan-to'g'ri chiqamiz.
            Auditoriyani tasodifan emas, ma'lumotga asoslanib tanlaymiz.
          </p>
        </div>

        <!-- Stats -->
        <div class="mt-12 grid grid-cols-3 gap-4">
          <div class="rounded-xl border border-light/5 bg-light/[0.02] p-4 text-center">
            <div class="text-2xl font-bold text-accent md:text-3xl">10M+</div>
            <div class="mt-1 text-xs text-light/60">O'zbekistonda foydalanuvchi</div>
          </div>
          <div class="rounded-xl border border-light/5 bg-light/[0.02] p-4 text-center">
            <div class="text-2xl font-bold text-accent md:text-3xl">18-45</div>
            <div class="mt-1 text-xs text-light/60">Asosiy yosh oralig'i</div>
          </div>
          <div class="rounded-xl border border-light/5 bg-light/[0.02] p-4 text-center">
            <div class="text-2xl font-bold text-accent md:text-3xl">$200+</div>
            <div class="mt-1 text-xs text-light/60">Oylik xizmat narxi</div>
          </div>
        </div>

        <!-- Features -->
        <div class="mt-16">
          <h2 class="text-center text-2xl font-bold text-light md:text-3xl">
            Instagram target xizmati nimalarni o'z ichiga oladi?
          </h2>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {features.map((feature) => (
              <div class="rounded-xl border border-light/5 bg-dark p-6">
                <h3 class="font-semibold text-light">{feature.title}</h3>
                <p class="mt-2 text-sm text-light/60">{feature.description}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Process -->
        <div class="mt-16">
          <h2 class="text-center text-2xl font-bold text-light md:text-3xl">
            Ishlash jarayoni
          </h2>
          <div class="mt-8 space-y-4">
            {steps.map((s) => (
              <div class="flex gap-4 rounded-xl border border-light/5 bg-dark p-6">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-bold text-light">{s.n}</div>
                <div>
                  <h3 class="font-semibold text-light">{s.title}</h3>
                  <p class="mt-1 text-sm text-light/60">{s.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <!-- FAQ -->
        <div class="mt-16">
          <h2 class="text-center text-2xl font-bold text-light md:text-3xl">
            Instagram target xizmati bo'yicha savollar
          </h2>
          <div class="mt-8 space-y-3">
            {faq.map((item) => (
              <details class="group rounded-xl border border-light/5 bg-dark p-6">
                <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-light marker:content-none">
                  {item.question}
                  <svg class="h-5 w-5 shrink-0 text-accent transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-light/60">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
